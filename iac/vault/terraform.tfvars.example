vault_addr  = "http://vault.homelab.internal"
# Fill this privately; never commit a populated terraform.tfvars file.
vault_token = ""

# Vault runs inside this Kubernetes cluster, so its internal API address is usable.
# Alternatively, use a cluster API URL reachable from the Vault pod.
kubernetes_host = "https://kubernetes.default.svc:443"

# Example:
# kubectl -n vault get secret vault-token-reviewer-token -o jsonpath='{.data.ca\.crt}' | base64 --decode
# Paste the complete PEM certificate between the markers, including BEGIN/END lines.
# Multiline certificates require a heredoc; do not wrap the PEM in double quotes.
kubernetes_ca_cert = <<-EOT
EOT

# Example:
# kubectl -n vault get secret vault-token-reviewer-token -o jsonpath='{.data.token}' | base64 --decode
# Keep the decoded token on one line. Do not use a short-lived `kubectl create token` here.
token_reviewer_jwt = ""

grafana_credentials = {
  username = "admin"
  # Generate once with: openssl rand -hex 32
  password = ""
}

# Install the workstation utility if missing: sudo apt install apache2-utils
# Run: htpasswd -nB prometheus
# Enter your chosen password at the hidden prompt; keep it in your password manager.
# Paste the complete resulting prometheus:<bcrypt-hash> line between the quotes.
# Dollar signs in the bcrypt output are literal in HCL; no escaping is needed.
prometheus_users = ""

# Generate once: openssl rand -base64 32
# Prefix that output with base64: and paste it below. Preserve it across upgrades.
# Losing/changing APP_KEY prevents decryption of stored provider tokens.
shoutrrr_credentials = {
  app_key = ""
  # Obtain from your LinkedIn developer application; no shell command can create these.
  # https://www.linkedin.com/developers/apps
  # Register this exact HTTPS callback:
  # https://shoutrrr.hyperoot.dev/accounts/callback/linkedin
  # Keep both empty until connecting LinkedIn.
  linkedin_client_id     = ""
  linkedin_client_secret = ""
  # Facebook + Instagram share a Meta app; no command generates its credentials.
  # Obtain App ID and App Secret from https://developers.facebook.com/apps/
  # Add Facebook Login and register the exact callback used by this deployment:
  # https://shoutrrr.hyperoot.dev/accounts/callback/meta
  # Link a professional Instagram account to a Facebook Page you manage.
  # Keep these empty until your Meta app is ready; see docs/apps/shoutrrr.md.
  facebook_client_id     = ""
  facebook_client_secret = ""
}

# One-time workstation authorization: cloudflared tunnel login
# List tunnels: cloudflared tunnel list
# Create only if absent: cloudflared tunnel create homelab
# Recover a credential file without printing it:
# cloudflared tunnel token --cred-file /private/path/tunnel.json <TUNNEL_ID>
# Copy AccountTag, TunnelID, and TunnelSecret into this object in private tfvars.
# The tunnel_id must also match gitops/infrastructure/cloudflared/config.yaml.
# This JSON is a connector credential, not the account-level cert.pem.
cloudflared_credentials = null
# cloudflared_credentials = {
#   account_tag   = ""
#   tunnel_id     = ""
#   tunnel_secret = ""
# }
