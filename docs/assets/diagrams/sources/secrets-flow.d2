vars: {d2-config: {layout-engine: elk; theme-id: 200; pad: 24}}
direction: down
style: {fill: "#0b1220"; stroke: transparent}
classes: {
  step: {style: {fill: "#142438"; stroke: "#8f80c8"; border-radius: 12; font-size: 22}}
  service: {shape: image; width: 64; height: 64; style.font-size: 22}
}
bootstrap: "Operator + Terraform\nInitialize / unseal · auth / policy · KV values" {class: step; style.stroke: "#e4bc78"}
identity: "Kubernetes identity\nESO ServiceAccount · audience: vault" {class: step}
vault: "Vault KV v2\nexternal-secrets mount" {class: service; icon: ../icons/vault.svg}
eso: "External Secrets" {class: service; icon: ../icons/external-secrets.svg}
secrets: "Namespaced Kubernetes Secrets\nMonitoring + Postiz credentials" {class: step; shape: document}
consumers: "Monitoring + Postiz credential consumers" {
  grid-columns: 3
  grid-gap: 30
  style: {fill: "#122033"; stroke: "#78d7c6"; border-radius: 16; font-size: 24}
  grafana: "Grafana login" {class: service; icon: ../icons/grafana.svg}
  prometheus: "Prometheus ingress auth" {class: service; icon: ../icons/prometheus.svg}
  postiz: "Postiz stack" {class: service; icon: ../icons/postiz.svg}
}
bootstrap -> vault: configure {style: {stroke: "#e4bc78"; font-size: 19}}
identity -> vault: authenticate {style.font-size: 19}
vault -> eso: "approved values" {style.font-size: 19}
eso -> secrets: synchronize {style.font-size: 19}
secrets -> consumers: consume {style.font-size: 19}
