vars: {d2-config: {layout-engine: elk; theme-id: 200; pad: 24}}
direction: down
style: {fill: "#0b1220"; stroke: transparent}
classes: {
  step: {style: {fill: "#142438"; stroke: "#5f88b5"; border-radius: 12; font-size: 22}}
  service: {shape: image; width: 52; height: 52; style.font-size: 21}
}
workstation: "Workstation browser\nhttp://<service>.homelab.internal" {class: step}
hosts: "Workstation /etc/hosts\n<K3S_NODE_IP>  <service>.homelab.internal" {class: step; shape: document}
ingress: "K3s ingress" {
  grid-columns: 2
  grid-gap: 24
  style: {fill: "#112d33"; stroke: "#78d7c6"; border-radius: 16; font-size: 24}
  servicelb: "Node LAN address\nServiceLB" {class: step}
  traefik: Traefik {class: service; icon: ../icons/traefik.svg}
}
interfaces: "Hostname → Service → ready endpoints" {
  grid-columns: 3
  grid-gap: 30
  style: {fill: "#122033"; stroke: "#78d7c6"; border-radius: 16; font-size: 24}
  homepage: Homepage {class: service; icon: ../icons/homepage.png}
  linkding: Linkding {class: service; icon: ../icons/linkding.svg}
  shoutrrr: Shoutrrr {class: service; icon: ../icons/shoutrrr.svg}
  flux: "Flux UI" {class: service; icon: ../icons/flux.svg}
  vault: Vault {class: service; icon: ../icons/vault.svg}
  grafana: Grafana {class: service; icon: ../icons/grafana.svg}
  prometheus: Prometheus {class: service; icon: ../icons/prometheus.svg}
}
workstation -> hosts: resolve {style.font-size: 19}
hosts -> ingress: "HTTP · port 80" {style.font-size: 19}
ingress -> interfaces: "Ingress hostname match" {style.font-size: 19}
